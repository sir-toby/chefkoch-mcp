# Chefkoch account whose cookbook the server reads.
CHEFKOCH_USERNAME=name@example.org
CHEFKOCH_PASSWORD=

# Public URL claude.ai connects to; the MCP endpoint is $PUBLIC_BASE_URL/mcp.
PUBLIC_BASE_URL=https://chefkoch.example.org

# GitHub OAuth app (github.com/settings/developers), callback URL:
#   $PUBLIC_BASE_URL/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to use the connector.
ALLOWED_GITHUB_USERS=sir-toby

# Signs the tokens handed to claude.ai and encrypts the stored OAuth state.
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Local testing only - anyone who reaches the port reads the cookbook.
# AUTH_DISABLED=true
